# ===================================================================
#  watch sniper — environment. Copy to `.env` and fill in.
#
#  GENERATED by `python -m watchsniper env-example`. Do not hand-edit:
#  it is derived from the variables config.py actually reads, which is
#  what stops it listing things the code ignores or omitting things it
#  needs.
#
#  There is deliberately no eBay USER token here. Phase 1 uses the
#  application (client-credentials) token, which cannot bid and cannot
#  buy. Adding a user token is a startup failure, not a feature flag.
# ===================================================================

# ------------------------------------------------------------------
# WHERE: developer.ebay.com/my/keys -> Production keyset -> 'App ID
# (Client ID)'
# IF MISSING: The service refuses to start. Nothing can be ingested.
EBAY_CLIENT_ID=

# ------------------------------------------------------------------
# WHERE: developer.ebay.com/my/keys -> Production keyset -> 'Cert ID
# (Client Secret)'
# IF MISSING: The service refuses to start. Nothing can be ingested.
EBAY_CLIENT_SECRET=

# ------------------------------------------------------------------
# WHERE: Leave as 'production'. 'sandbox' has almost no UK watch
# listings.
# IF MISSING: Defaults to production.
EBAY_ENV=production

# ------------------------------------------------------------------
# WHERE: Do not change. UK-domestic sourcing is a hard requirement.
# IF MISSING: Defaults to EBAY_GB.
EBAY_MARKETPLACE_ID=EBAY_GB

# ------------------------------------------------------------------
# WHERE: Leaf category for Wristwatches. Run `python -m watchsniper
# diagnose` to confirm it resolves on EBAY_GB before changing it.
# IF MISSING: Defaults to 31387. Without a category filter, ~21% of
# results are straps and bracelets that name the watch they fit.
EBAY_CATEGORY_IDS=31387

# ------------------------------------------------------------------
# WHERE: eBay's published Browse limit for your application, minus
# headroom. `diagnose` reports the limit if the API exposes it.
# IF MISSING: Defaults to 4800.
EBAY_DAILY_CALL_CEILING=4800

# ------------------------------------------------------------------
# WHERE: Invent one. Any long random string, e.g. `openssl rand -hex
# 12`, or just mash the keyboard. No account and no credential exist
# for ntfy.sh — the topic name IS the address, so anyone who guesses
# it reads your alerts. Install the ntfy app from the Play Store, add
# this topic, done.
# IF MISSING: Notifications are disabled. The dashboard and the poller
# still work; you simply find out by looking rather than by being
# told.
NTFY_TOPIC=

# ------------------------------------------------------------------
# WHERE: Leave as-is unless you self-host ntfy on the VPS later.
# IF MISSING: Defaults to the public ntfy.sh.
NTFY_SERVER=https://ntfy.sh

# ------------------------------------------------------------------
# WHERE: A writable path on the VPS. A single SQLite file; back it up
# by copying it.
# IF MISSING: Defaults to watchsniper.db beside the code.
DB_PATH=

# ------------------------------------------------------------------
# WHERE: Leave at 127.0.0.1. cloudflared reaches the dashboard on
# localhost and Cloudflare Access does the authentication; the service
# itself has no login. The systemd unit pins this to loopback. Setting
# 0.0.0.0 publishes an unauthenticated dashboard to the internet.
# IF MISSING: Defaults to loopback only.
BIND_HOST=127.0.0.1

# ------------------------------------------------------------------
# WHERE: Any free port.
# IF MISSING: Defaults to 8137.
BIND_PORT=8137

# ------------------------------------------------------------------
# WHERE: The address you open the dashboard at from your phone: the
# Cloudflare Tunnel public hostname protected by Access, e.g.
# https://watches.example.com. Used for the dashboard links in ntfy
# alerts. No trailing slash needed.
# IF MISSING: Links fall back to http://localhost:<BIND_PORT>, which
# only works on the server itself.
PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# WHERE: Seconds between Buy It Now sweeps. Genuinely underpriced BIN
# listings go in minutes, so this is the number that matters.
# IF MISSING: Defaults to 90.
POLL_BIN_SECONDS=90

# ------------------------------------------------------------------
# WHERE: Seconds between auction sweeps. Auctions have hours of
# runway, so this can be slow.
# IF MISSING: Defaults to 600.
POLL_AUCTION_SECONDS=600

# ------------------------------------------------------------------
# WHERE: Seconds without a successful poll before you are told
# ingestion has stopped (requirement 7).
# IF MISSING: Defaults to 1800 (30 minutes).
HEARTBEAT_STALE_SECONDS=1800
